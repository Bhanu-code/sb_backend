// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  customer
  advisor
  master_agent
  admin
}

enum CommissionStatus {
  pending
  paid
  failed
}

enum CommissionType {
  joining
  subscription
}

enum InterestStatus {
  pending
  accepted
  declined
}

enum OtpChannel {
  email
  sms
}

enum NotificationType {
  like
  comment
  connection_request
  connection_accepted
  message
  system
}

enum ReportReason {
  fake_profile
  inappropriate_content
  harassment
  spam
  other
}

enum MediaType {
  image
  video
}

enum MasterAgentRequestStatus {
  pending
  approved
  rejected
}

enum Religion {
  hindu
  muslim
  christian
  sikh
  buddhist
  jain
  parsi
  jewish
  other
}

enum EducationLevel {
  high_school
  diploma
  bachelors
  masters
  phd
  professional
  other
}

enum OccupationCategory {
  engineering_technology
  healthcare
  finance
  government
  education
  business_management
  arts_media
  legal
  self_employed
  student
  other
}

enum MaritalStatus {
  never_married
  divorced
  widowed
  awaiting_divorce
}

enum IdDocumentType {
  aadhar
  pan
}

enum IdVerificationStatus {
  none
  pending
  approved
  rejected
}

enum PhysicalStatus {
  normal
  physically_challenged
}

enum ProfileCreatedBy {
  self
  parent
  sibling
  relative
  friend
}

enum EmploymentType {
  private_sector
  government
  business
  self_employed
  not_working
}

enum EatingHabit {
  vegetarian
  non_vegetarian
  eggetarian
  vegan
}

enum SmokingHabit {
  no
  occasionally
  yes
}

enum DrinkingHabit {
  no
  occasionally
  yes
}

enum FamilyStatus {
  middle_class
  upper_middle_class
  rich
  affluent
}

enum FamilyValue {
  traditional
  moderate
  liberal
}

enum FamilyType {
  nuclear
  joint
}

enum Nakshatra {
  ashwini
  bharani
  krittika
  rohini
  mrigashira
  ardra
  punarvasu
  pushya
  ashlesha
  magha
  purva_phalguni
  uttara_phalguni
  hasta
  chitra
  swati
  vishakha
  anuradha
  jyeshtha
  moola
  purva_ashadha
  uttara_ashadha
  shravana
  dhanishta
  shatabhisha
  purva_bhadrapada
  uttara_bhadrapada
  revati
}

enum DoshamStatus {
  none
  manglik
  other
  dont_know
}

model User {
  id              String    @id @default(uuid())
  email           String?   @unique
  phone           String?   @unique
  passwordHash    String?
  fullName        String?
  dateOfBirth     DateTime?
  gender          String?
  role            Role      @default(customer)
  referralCode    String    @unique
  referredById    String?
  referralCount   Int       @default(0)
  isActive        Boolean   @default(true)
  profileComplete Boolean   @default(false)
  emailVerified   Boolean   @default(false)
  phoneVerified   Boolean   @default(false)
  idVerified      Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  notificationsEnabled   Boolean @default(true)
  locationSharingEnabled Boolean @default(false)

  // Self-relation: NOT cascaded on delete — removing a referring advisor
  // shouldn't wipe out everyone they referred. referredById is set to
  // null instead, so the referred users just lose their attribution.
  referredBy     User?  @relation("ReferralTree", fields: [referredById], references: [id], onDelete: SetNull)
  referrals      User[] @relation("ReferralTree")
  passesGiven    Pass[] @relation("PassedBy")
  passesReceived Pass[] @relation("PassedOn")

  profile              Profile?
  subscription         Subscription?
  otpTokens            OtpToken[]
  sentInterests        Interest[]    @relation("SentInterests")
  receivedInterests    Interest[]    @relation("ReceivedInterests")
  commissionsEarned    Commission[]  @relation("CommissionBeneficiary")
  commissionsTriggered Commission[]  @relation("CommissionSource")
  sessions             Session[]

  posts    Post[]
  reels    Reel[]
  comments Comment[]
  likes    Like[]

  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")

  notifications Notification[]

  blockedUsers   Block[] @relation("Blocker")
  blockedByUsers Block[] @relation("Blocked")

  reportsMade     Report[] @relation("Reporter")
  reportsReceived Report[] @relation("Reported")

  masterAgentRequest MasterAgentRequest?

  @@map("users")
}

model Profile {
  id                 String    @id @default(uuid())
  userId             String    @unique
  bio                String?
  avatarUrl          String?
  coverUrl           String?
  height             Int? // in cm
  religion           Religion?
  caste              String?
  motherTongue       String?
  education          String?
  occupation         String?
  annualIncome       String?
  city               String?
  address            String?
  pincode            String?
  state              String?
  latitude           Float?
  longitude          Float?
  photos             String[] // S3 URLs
  partnerAgeMin      Int?
  partnerAgeMax      Int?
  partnerReligion    Religion?
  partnerCaste       String?
  matrimonyVisible   Boolean   @default(true)
  verificationDocUrl String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  maritalStatus MaritalStatus?

  // Expanded partner preferences
  partnerEducationLevel     EducationLevel?
  partnerOccupationCategory OccupationCategory?
  partnerCity               String?
  partnerState              String?
  partnerHeightMin          Int?
  partnerHeightMax          Int?
  partnerMotherTongue       String?
  partnerMaritalStatus      MaritalStatus?

  partnerPhysicalStatus   PhysicalStatus?
  partnerEmploymentType   EmploymentType?
  partnerFamilyStatus     FamilyStatus?
  partnerFamilyValue      FamilyValue?
  partnerFamilyType       FamilyType?
  partnerNakshatra        Nakshatra?

  // Replacing free-text state/city with Indian-specific fields
  district        String?
  partnerDistrict String?


  // ID verification
  idDocumentType                IdDocumentType?
  idVerificationStatus          IdVerificationStatus @default(none)
  idVerificationSubmittedAt     DateTime?
  idVerificationReviewedAt      DateTime?
  idVerificationReviewedBy      String?
  idVerificationRejectionReason String?

  educationLevel     EducationLevel?
  occupationCategory OccupationCategory?

  physicalStatus   PhysicalStatus?
  profileCreatedBy ProfileCreatedBy?
  employmentType   EmploymentType?
  country          String?
  citizenship      String?

  eatingHabit   EatingHabit?
  smokingHabit  SmokingHabit?
  drinkingHabit DrinkingHabit?
  hobbies       String[]

  familyStatus FamilyStatus?
  familyValue  FamilyValue?
  familyType   FamilyType?

  horoscopeAvailable Boolean       @default(false)
  horoscopeUrl       String?
  rashi              String?
  nakshatra          Nakshatra?
  dosham             DoshamStatus?

  // Partner preference equivalents
  partnerEatingHabit   EatingHabit?
  partnerSmokingHabit  SmokingHabit?
  partnerDrinkingHabit DrinkingHabit?
  partnerCountry       String?
  partnerDosham        DoshamStatus?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([religion, caste])
  @@index([city, state])
  @@map("profiles")
}

model Pass {
  id        String   @id @default(uuid())
  userId    String // who passed
  targetId  String // who they passed on
  createdAt DateTime @default(now())

  user   User @relation("PassedBy", fields: [userId], references: [id], onDelete: Cascade)
  target User @relation("PassedOn", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([userId, targetId])
  @@map("passes")
}

model OtpToken {
  id        String     @id @default(uuid())
  userId    String
  target    String // email address or phone number
  channel   OtpChannel
  otp       String
  expiresAt DateTime
  used      Boolean    @default(false)
  createdAt DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, channel])
  @@map("otp_tokens")
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Interest {
  id         String         @id @default(uuid())
  senderId   String
  receiverId String
  status     InterestStatus @default(pending)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  sender   User @relation("SentInterests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedInterests", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
  @@index([receiverId, status])
  @@map("interests")
}

model Commission {
  id            String           @id @default(uuid())
  beneficiaryId String
  sourceUserId  String
  level         Int
  amount        Decimal          @db.Decimal(10, 2)
  type          CommissionType
  status        CommissionStatus @default(pending)
  createdAt     DateTime         @default(now())

  beneficiary User @relation("CommissionBeneficiary", fields: [beneficiaryId], references: [id], onDelete: Cascade)
  sourceUser  User @relation("CommissionSource", fields: [sourceUserId], references: [id], onDelete: Cascade)

  @@map("commissions")
}

model Subscription {
  id              String   @id @default(uuid())
  userId          String   @unique
  plan            String // basic | premium | gold
  status          String // active | expired | cancelled
  razorpayOrderId String?
  amount          Decimal  @db.Decimal(10, 2)
  startDate       DateTime
  endDate         DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model Post {
  id        String     @id @default(uuid())
  authorId  String
  content   String?
  imageUrl  String?
  mediaType MediaType?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  author   User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments Comment[]
  likes    Like[]

  @@index([authorId])
  @@map("posts")
}

model Reel {
  id           String   @id @default(uuid())
  authorId     String
  videoUrl     String
  thumbnailUrl String?
  caption      String?
  views        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  author   User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments Comment[]
  likes    Like[]

  @@index([authorId])
  @@map("reels")
}

model Comment {
  id        String   @id @default(uuid())
  authorId  String
  content   String
  createdAt DateTime @default(now())

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  postId String?
  post   Post?   @relation(fields: [postId], references: [id], onDelete: Cascade)

  reelId String?
  reel   Reel?   @relation(fields: [reelId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([reelId])
  @@map("comments")
}

model Like {
  id        String   @id @default(uuid())
  userId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  postId String?
  post   Post?   @relation(fields: [postId], references: [id], onDelete: Cascade)

  reelId String?
  reel   Reel?   @relation(fields: [reelId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@unique([userId, reelId])
  @@map("likes")
}

model Message {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  content    String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender   User @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId, receiverId])
  @@index([receiverId, read])
  @@map("messages")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  body      String?
  read      Boolean          @default(false)
  relatedId String? // e.g. postId, interestId, messageId — polymorphic reference
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@map("notifications")
}

model Block {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@map("blocks")
}

model Report {
  id          String       @id @default(uuid())
  reporterId  String
  reportedId  String
  reason      ReportReason
  description String?
  resolved    Boolean      @default(false)
  createdAt   DateTime     @default(now())

  reporter User @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reported User @relation("Reported", fields: [reportedId], references: [id], onDelete: Cascade)

  @@map("reports")
}

model MasterAgentRequest {
  id          String                   @id @default(uuid())
  userId      String                   @unique
  status      MasterAgentRequestStatus @default(pending)
  requestedAt DateTime                 @default(now())
  reviewedAt  DateTime?
  reviewedBy  String?
  note        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("master_agent_requests")
}
